#!/usr/bin/env python3
"""Restic backup wrapper. Reads config from ~/.config/restic-backup/config.toml."""

import os
import subprocess
import sys
import tomllib

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "restic-backup",
)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.toml")
PASSWORD_FILE = os.path.join(CONFIG_DIR, "password")

COMMON_BACKUP_ARGS = ["--exclude-caches", "--no-scan", "--retry-lock", "2h"]

PRUNE_POLICY = [
    "--keep-daily", "7",
    "--keep-weekly", "5",
    "--keep-monthly", "12",
    "--keep-yearly", "5",
]


def load_config() -> dict:
    if not os.path.isfile(CONFIG_FILE):
        print(f"error: config not found: {CONFIG_FILE}", file=sys.stderr)
        sys.exit(1)
    if not os.path.isfile(PASSWORD_FILE):
        print(f"error: password file not found: {PASSWORD_FILE}", file=sys.stderr)
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)


def restic(*args: str) -> None:
    cfg = load_config()
    env = {
        **os.environ,
        "RESTIC_REPOSITORY": cfg["repository"],
        "RESTIC_PASSWORD_FILE": PASSWORD_FILE,
    }
    os.execvpe("restic", ["restic", *args], env)


def cmd_run(extra_args: list[str]) -> None:
    cfg = load_config()

    paths = []
    for p in cfg.get("paths", []):
        p = os.path.expanduser(p)
        if os.path.exists(p):
            paths.append(p)
        else:
            print(f"skip (not found): {p}", file=sys.stderr)
    if not paths:
        print("error: no backup paths found", file=sys.stderr)
        sys.exit(1)

    excludes = []
    for e in cfg.get("excludes", []):
        excludes += ["--exclude", e]

    restic("backup", *COMMON_BACKUP_ARGS, *excludes, *paths, *extra_args)


def main() -> None:
    args = sys.argv[1:]
    cmd = args[0] if args else "run"
    rest = args[1:] if args else []

    match cmd:
        case "run":
            cmd_run(rest)
        case "snapshots":
            restic("snapshots", *rest)
        case "restore":
            restic("restore", *rest)
        case "prune":
            restic("forget", "--prune", *PRUNE_POLICY, *rest)
        case "init":
            restic("init", *rest)
        case "raw":
            restic(*rest)
        case _:
            print("usage: restic-backup {run|snapshots|restore|prune|init|raw}", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
