#!/usr/bin/env python3
import argparse
import base64
import json
import os
import socket
import sys
import urllib.request

CREDENTIALS_PATH = os.path.expanduser("~/.config/ntfy-agent/credentials")


def starfish(p: str, max_depth: int = 4) -> str:
    p = os.path.normpath(p or "")
    if not p:
        return "unknown"
    abs_ = p.startswith(os.sep)
    parts = [x for x in p.split(os.sep) if x]
    if len(parts) <= 1:
        return (os.sep + parts[0]) if abs_ and parts else (p if parts else os.sep)
    if len(parts) > max_depth:
        mid = [parts[0], "...", parts[-2], parts[-1]]
        return (os.sep if abs_ else "") + os.sep.join(mid)
    parents = [(x if x in (".", "...") else x[:1]) for x in parts[:-1]]
    return (os.sep if abs_ else "") + os.sep.join(parents + [parts[-1]])


def send_ntfy(title: str, body: str) -> None:
    creds = json.load(open(CREDENTIALS_PATH))
    req = urllib.request.Request(creds["url"], data=body.encode("utf-8"), method="POST")
    req.add_header("Title", title)
    req.add_header("Content-Type", "text/plain; charset=utf-8")
    req.add_header("User-Agent", "curl/8.5.0")
    token = base64.b64encode(creds["user"].encode("utf-8")).decode("ascii")
    req.add_header("Authorization", f"Basic {token}")
    urllib.request.urlopen(req, timeout=10).read()


def read_payload(arg):
    raw = arg or ""
    if not raw:
        try:
            if not sys.stdin.isatty():
                raw = sys.stdin.read()
        except Exception:
            pass
    if not raw or not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        return {}


def tool_msg(n):
    if "tool_name" not in n:
        return ""
    tool = n["tool_name"]
    inp = n.get("tool_input") or {}
    detail = ""
    for v in (inp.get("command"), inp.get("file_path"), n.get("command"), n.get("description")):
        if v:
            detail = v[:40]
            break
    return f"Approve {tool}: {detail}" if detail else f"Approve {tool}"


def main() -> None:
    p = argparse.ArgumentParser()
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--codex", action="store_true")
    g.add_argument("--claude-code", action="store_true")
    g.add_argument("--gemini-cli", action="store_true")
    p.add_argument("payload", nargs="?")
    args = p.parse_args()

    host = socket.gethostname().split(".")[0]
    n = read_payload(args.payload)
    cwd = n.get("cwd") or os.getcwd()
    project = os.path.basename(cwd)
    body = f"{host}:{starfish(cwd)}"

    if args.codex:
        if not n or n.get("type") not in ("approval-requested", "agent-turn-complete"):
            return
        if n.get("type") == "approval-requested":
            cmd = n.get("command") or ""
            reason = "Approval Requested"
            msg = f"Approval requested: {cmd}" if cmd else "Approval requested."
        else:
            reason = "Done"
            msg = n.get("last-assistant-message") or "Turn Complete!"
        send_ntfy(f"{project}: {reason}", f"{body}\n{msg[:80]}")
        return

    if args.gemini_cli:
        msg = tool_msg(n) or n.get("prompt_response") or ""
        reason = "Approve" if "tool_name" in n else "Done"
        send_ntfy(f"{project}: {reason}", f"{body}\n{msg[:80]}")
        return

    # claude-code
    msg = tool_msg(n) or n.get("message") or ""
    if "stop_reason" in n:
        reason = "Done"
        msg = msg or "Done"
    elif "tool_name" in n:
        reason = "Approve"
    elif n.get("message"):
        reason = "Input Needed"
    else:
        reason = "Done"
    send_ntfy(f"{project}: {reason}", f"{body}\n{msg[:80]}")


if __name__ == "__main__":
    main()
