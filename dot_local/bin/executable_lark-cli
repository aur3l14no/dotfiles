#!/usr/bin/env bash
set -euo pipefail

if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
    printf '%s\n' "lark-cli requires Node.js and npm. Ask the user to initialize them through skill-ops." >&2
    exit 127
fi

if [[ "${1:-}" == "update" ]]; then
    check_only=false
    for arg in "$@"; do
        if [[ "$arg" == "--check" ]]; then
            check_only=true
            break
        fi
    done
    if [[ "$check_only" != true ]]; then
        printf '%s\n' \
            "lark-cli update is disabled: the executable version is pinned in this wrapper," \
            "and Lark skills are managed by APM." >&2
        exit 2
    fi
fi

export LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1
export LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1
export NPM_CONFIG_UPDATE_NOTIFIER=false

# An empty cache-owned prefix avoids resolving a package from the caller's project.
cache="${NPM_USER_CACHE:-$HOME/.cache/npm}"
mkdir -p "$cache/skill-tools/lark-cli"
exec npm --cache "$cache" --prefix "$cache/skill-tools/lark-cli" exec \
    --yes --package=@larksuite/cli@1.0.94 -- lark-cli "$@"
