hm_session_vars="/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh"
[ -r "$hm_session_vars" ] && . "$hm_session_vars"

# User and host-local tools. mise shims serve shells that return before
# `mise activate` below: ssh commands, Codex remote, service installers.
for dir in \
    /opt/homebrew/sbin \
    /opt/homebrew/bin \
    "$HOME/.local/opt/npm-global/bin" \
    "$HOME/.local/share/mise/shims" \
    "$HOME/.local/bin"; do
    if [ -d "$dir" ]; then
        case ":$PATH:" in
            *:"$dir":*) ;;
            *) PATH="$dir${PATH:+:$PATH}" ;;
        esac
    fi
done
export PATH

# Auto-attach to tmux for SSH interactive shells
case $- in
    *i*) ;;
    *) return ;;
esac

[ -n "${BASH_EXECUTION_STRING-}" ] && return

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
elif [ -x "$HOME/.local/bin/mise" ]; then
    eval "$("$HOME/.local/bin/mise" activate bash)"
fi

[ -n "${TMUX-}" ] && return
case "${TERM_PROGRAM-}" in
    vscode|zed) return ;;
esac

command -v tmux >/dev/null 2>&1 || return
exec tmux new -A -s main
