# Shared bash/zsh environment; keep this silent and safe to source repeatedly.
__shell_hm_vars={{ joinPath "/etc/profiles/per-user" .chezmoi.username "etc/profile.d/hm-session-vars.sh" | shellQuote }}
if [ -r "$__shell_hm_vars" ]; then
    . "$__shell_hm_vars"
fi

# Fill gaps without moving inherited paths (temporary tools, venvs, dev shells).
for __shell_dir in{{ range (includeTemplate "shell-paths.yaml" . | fromYaml).shellPaths }} \
    {{ . | shellQuote }}{{ end }}; do
    if [ -d "$__shell_dir" ]; then
        case ":${PATH-}:" in
            *:"$__shell_dir":*) ;;
            *) PATH="${PATH:+$PATH:}$__shell_dir" ;;
        esac
    fi
done
export PATH
unset __shell_hm_vars __shell_dir

# Optional host-local environment, including non-interactive shells; keep it silent.
if [ -r "$HOME/.config/shell/local.sh" ]; then
    . "$HOME/.config/shell/local.sh"
fi
