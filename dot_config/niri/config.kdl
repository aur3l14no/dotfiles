debug {
    // Allows notification actions and window activation from Noctalia
    honor-xdg-activation-with-invalid-serial
}

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "google-chrome-stable"
spawn-at-startup "google-chrome-stable" "--app=https://chatgpt.com"
spawn-at-startup "google-chrome-stable" "--app=https://web.telegram.org"
spawn-at-startup "wechat-uos"

input {
    keyboard {
        xkb {
            options "caps:super"
        }
        repeat-delay 200
        repeat-rate 40
    }

    touchpad {
        natural-scroll
    }
}

output "Microstep MAG274UPF CC2H623700305" {
    mode "3840x2160@120.000"
    scale 1.5
}

// fusco-thinkbook built-in panel
output "China Star Optoelectronics Technology Co., Ltd MNE507ZA2-4 Unknown" {
    mode "3072x1920@120.000"
}

gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 6
    default-column-width { proportion 1.0; }
}

prefer-no-csd

workspace "terminal"
workspace "browser"
workspace "chat"
workspace "ai"

window-rule {
    match app-id=r#"^Alacritty$"#
    open-on-workspace "terminal"
    open-floating false
}

window-rule {
    match app-id=r#"^google-chrome$"#
    open-on-workspace "browser"
    open-floating false
}

window-rule {
    match app-id=r#"^wechat$"#
    open-on-workspace "chat"
    open-floating false
}

// Chrome --app= gets URL-based app-id at startup (e.g. chrome-chatgpt.com__-Default)
// but extension-based app-id from launcher (e.g. chrome-cadlki...-Default).
// Title is not available at window creation for autostarted apps,
// so first match uses URL-based app-id for startup; second uses title for launcher.
window-rule {
    match app-id=r#"^chrome-chatgpt\.com"#
    match app-id=r#"^chrome-"# title=r#"^ChatGPT"#
    open-on-workspace "chat"
    open-floating false
}

window-rule {
    match app-id=r#"^chrome-web\.telegram\.org"#
    match app-id=r#"^chrome-"# title=r#"^Telegram"#
    open-on-workspace "ai"
    open-floating false
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Space { toggle-overview; }
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+V { spawn "noctalia-shell" "ipc" "call" "launcher" "clipboard"; }
    Mod+E { spawn "nautilus"; }
    Mod+Alt+L { spawn "loginctl" "lock-session"; }

    Mod+Q { close-window; }

    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Shift+M     { move-workspace-to-monitor-next; }

    Mod+Tab            { focus-workspace-previous; }
    Mod+J              { focus-workspace-down; }
    Mod+K              { focus-workspace-up; }
    Mod+Ctrl+J         { move-column-to-workspace-down; }
    Mod+Ctrl+K         { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Ctrl+Alt+Shift+A { screenshot; }

    Mod+Shift+E { quit; }

    Mod+Shift+P { power-off-monitors; }
}
