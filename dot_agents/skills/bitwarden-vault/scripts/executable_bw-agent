#!/usr/bin/env bash
#
# bw-agent — run any `bw` command against a private, disposable copy of a
# pre-unlocked template.
#
# `bw` WRITES to its state directory: `unlock` rewrites the wrapped user key
# inside data.json (instantly invalidating any session that unwrapped the
# previous one) and `lock` deletes it. Two callers sharing one state directory
# therefore fight — that is the mechanism behind bitwarden/clients#6898. A
# private copy per call removes the shared state instead of arbitrating it, so
# concurrency needs no lock and no daemon.
#
# The template is a pair of files: `--setup` writes both, `sync` refreshes
# data.json in place. Neither is usable alone:
#
#   template/data.json   CLI state: tokens, wrapped user key, device identity
#   template/session     the BW_SESSION value that unwraps it
#
# The data.json copy is what makes the call writable; the session is passed as
# an environment variable and never lands in the copy.
#
# No credential file is read anywhere. --setup takes the master password from a
# prompt and writes it nowhere; the runtime path needs no password at all.
#
# Treat the template as an unrevocable credential for the whole vault: re-running
# --setup does NOT invalidate a copy that leaked. Rotating the account encryption
# key is the only real revocation.
set -euo pipefail
umask 077

BW_AGENT_DIR="${BW_AGENT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bitwarden-agent}"
TEMPLATE="${BW_AGENT_DIR}/template"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"; RUNTIME_DIR="${RUNTIME_DIR%/}"
WORK=

cleanup() { if [[ -n "$WORK" ]]; then rm -rf "$WORK"; WORK=; fi; }
trap cleanup EXIT INT TERM
die() { printf 'bw-agent: %s\n' "$*" >&2; exit 1; }

bw_run() {
  BW_SESSION="$(cat "$TEMPLATE/session")" \
  BITWARDENCLI_APPDATA_DIR="$WORK" \
    bw --nointeraction "$@"
}

# `bw` has no field projection and `list items` / `get item` return every field
# decrypted — login.password, login.totp, login.fido2Credentials, notes,
# custom-field values, passwordHistory. That output *is* the plaintext vault, so
# a single `bw list items` in a transcript is a full disclosure. Those two
# commands are the only ones that emit whole entries; both are projected here
# through an allow-list, so anything `bw` adds later fails closed. Single-field
# reads (`get password`, `get totp`) are the intended channel and pass through.
project_items() {
  jq '
    def safe: {
      id, name, type, object, favorite, reprompt,
      organizationId, collectionIds, folderId: (.folderId // null),
      username: (.login.username // null),
      uris: [.login.uris[]?.uri],
      customFields: [.fields[]?.name]
    };
    if type == "array" then map(safe) else safe end
  '
}

# Every call gets its own state directory, so concurrent callers cannot
# invalidate each other. Arguments pass straight through: the full `bw` surface
# is available and nothing here needs extending.
run_bw() {
  [[ -f "$TEMPLATE/data.json" && -f "$TEMPLATE/session" ]] ||
    die "no template at $TEMPLATE — a human must run: bw-agent --setup"
  command -v bw >/dev/null 2>&1 || die "bw is not on PATH"

  WORK="$(mktemp -d "${RUNTIME_DIR}/bw-agent.XXXXXX")"
  cp "$TEMPLATE/data.json" "$WORK/data.json"

  local sub1="${1:-}" sub2="${2:-}"
  # Only on an explicit request: reads stay served from the copied snapshot.
  if [[ "$sub1" == "sync" ]]; then
    bw_run "$@"
    install -m 600 "$WORK/data.json" "$TEMPLATE/data.json.new"
    mv -f "$TEMPLATE/data.json.new" "$TEMPLATE/data.json"
    return
  fi
  case "$sub1 $sub2" in
    "list items"|"get item")
      command -v jq >/dev/null 2>&1 || die "jq is required to read items safely"
      shift 2
      bw_run "$sub1" "$sub2" "$@" | project_items
      ;;
    "export "*)
      die "refusing to export the vault in plaintext"
      ;;
    *)
      bw_run "$@"
      ;;
  esac
}

# Human-only, one time. Freezes one unlocked session into the template; after
# this the master password is needed nowhere.
#
#   bw-agent --setup <SERVER_URL>               fresh machine; signs in, new device
#   BW_AGENT_STATE_DIR=<dir> bw-agent --setup   reuse an existing sign-in, no new device
#
# Exactly one of the two is required, so setup can never silently sign in to
# whatever server happens to be the default.
setup() {
  local server="${1:-}" password session

  [[ -n "$server" || -n "${BW_AGENT_STATE_DIR:-}" ]] ||
    die "pass a server URL, or set BW_AGENT_STATE_DIR to an existing CLI state"

  WORK="$(mktemp -d "${RUNTIME_DIR}/bw-agent-setup.XXXXXX")"
  export BITWARDENCLI_APPDATA_DIR="$WORK"

  if [[ -n "${BW_AGENT_STATE_DIR:-}" ]]; then
    cp "${BW_AGENT_STATE_DIR}/data.json" "$WORK/data.json" ||
      die "no data.json under $BW_AGENT_STATE_DIR"
  else
    bw config server "$server" --nointeraction >/dev/null 2>&1 ||
      die "could not point the CLI at $server"
    printf 'bw-agent: signing in to %s (registers a new device)\n' "$server" >&2
    bw login || die "sign-in failed"
  fi

  printf 'bw-agent: master password, used once and stored nowhere: ' >&2
  IFS= read -rs password || true
  printf '\n' >&2
  [[ -n "$password" ]] || die "no password given"

  session="$(BW_AGENT_PW="$password" \
    bw unlock --passwordenv BW_AGENT_PW --raw --nointeraction)" || die "unlock failed"
  unset password
  [[ -n "$session" ]] || die "unlock returned an empty session"
  bw sync --quiet --nointeraction >/dev/null

  mkdir -p "$TEMPLATE"
  chmod 700 "$BW_AGENT_DIR" "$TEMPLATE"
  cp "$WORK/data.json" "$TEMPLATE/data.json"
  printf '%s\n' "$session" > "$TEMPLATE/session"
  chmod 600 "$TEMPLATE/data.json" "$TEMPLATE/session"
  unset session

  printf 'bw-agent: template written to %s\n' "$TEMPLATE"
}

case "${1:-}" in
  --setup) shift; setup "$@" ;;
  *)       run_bw "$@" ;;
esac
